{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EdItOr",
  "version": "0.1.0",
  "identifier": "dev.sinrok.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EdItOr Studio",
        "width": 1180,
        "height": 800,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}